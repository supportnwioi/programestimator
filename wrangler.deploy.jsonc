{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Same name as the existing Worker, so it keeps the same workers.dev URL.
  "name": "programestimator",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-19",
  "observability": { "enabled": true },
  // Public site: no preview mode. To preview drafts, sign in as an admin
  // (or run locally with NWIOI_PREVIEW=1).
  "containers": [
    {
      "class_name": "EstimatorContainer",
      "scheduling_policy": "durable_object",
      "images": { "base": { "image": "registry.cloudflare.com/f6ee97e5a759676ea0d9397f66d028b7/nwioi-estimator@sha256:4618c3236b6672d192fd46e7e1c97e808ccc3521ea91d340e776e346405dec76" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ESTIMATOR", "class_name": "EstimatorContainer" }]
  },
  "exports": {
    "EstimatorContainer": { "type": "durable-object", "storage": "sqlite" }
  }
  // Secrets (set with `npx wrangler secret put <NAME>` or in the dashboard):
  //   NWIOI_ADMIN_PASSWORD  admin password (required for a shared test site)
  //   ANTHROPIC_API_KEY     optional; turns on AI document review
}
